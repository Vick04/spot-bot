# API URL for client
# For development (local server):
#   VITE_API_URL=http://localhost:3131
#
# For production (Docker/DigitalOcean - leave unset to use Nginx reverse proxy):
#   Leave this commented out to use /api relative path
#   The client will auto-detect the host and connect to /api
#
# VITE_API_URL=http://localhost:3131
