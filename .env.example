# ─────────────────────────────────────────────
# SPOT-BOT Configuration
# Copy this to .env and adjust values
# ─────────────────────────────────────────────

# Server Configuration
API_PORT=4444
NODE_ENV=development

# ── GainersManager Configuration ────────────────────────────────

# Number of symbols to track
#   0 or blank = load ALL available USDT symbols (default: all)
#   100        = load top 100 USDT symbols
#   50         = load top 50 USDT symbols
#   10         = load top 10 USDT symbols
GAINERS_SYMBOLS_LIMIT=0

# Minimum 24h volume in USDT for a symbol to be included
# Examples:
#   1000000      = $1M+ volume (default, excludes low-volume pairs)
#   100000       = $100k+ volume (includes more pairs)
#   10000        = $10k+ volume (includes very small pairs)
GAINERS_MIN_VOLUME=1000000

# Number of 1-minute candles to maintain per symbol
#   60  = 1 hour of data (default)
#   120 = 2 hours of data
#   240 = 4 hours of data
#   1440 = 24 hours of data (1 day)
GAINERS_BUFFER_SIZE=60
